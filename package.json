{
  "name": "dreamchain-cli",
  "version": "0.1.0",
  "description": "A lightweight CLI for turning conversations into trackable tasks.",
  "keywords": [
    "cli",
    "tasks",
    "productivity",
    "typescript"
  ],
  "homepage": "https://github.com/royalpinto007/dreamchain-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/royalpinto007/dreamchain-cli.git"
  },
  "bugs": {
    "url": "https://github.com/royalpinto007/dreamchain-cli/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "dreamchain": "./dist/index.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
